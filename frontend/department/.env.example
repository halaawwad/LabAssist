# Development defaults to the current hostname on port 8080, /login.
# Outside development set VITE_DEMO_MODE=true and configure the exact shared
# login URL, or configure the Student root URL as a compatibility alternative.
VITE_DEMO_MODE=
VITE_LOGIN_URL=
VITE_STUDENT_URL=
VITE_AUTH_MODE=api
VITE_API_URL=http://127.0.0.1:3100/v1
VITE_DEPARTMENT_URL=http://127.0.0.1:5176/
VITE_SUPERVISOR_URL=http://127.0.0.1:5174/
VITE_WORKSHOP_URL=http://127.0.0.1:5175/

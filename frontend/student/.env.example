# Shared web demo login is this app's /login. Development uses the current
# hostname with ports 8080/5174/5175/5176. Never put credentials in these URLs.
# Outside development, explicitly opt into this backend-free demo and configure
# every independent destination; missing URLs produce a configuration error.
VITE_DEMO_MODE=
# Optional override of this Student app's root URL.
VITE_STUDENT_URL=
VITE_SUPERVISOR_URL=
VITE_WORKSHOP_URL=
VITE_DEPARTMENT_URL=

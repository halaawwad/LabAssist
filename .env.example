# Docker and backend configuration: copy to .env in the repository root.
# Do not change credentials/database name for an existing volume to "reset" it.
COMPOSE_PROJECT_NAME=labassist-auth-sprint1
POSTGRES_USER=labassist_owner
POSTGRES_DB=labassist_auth_dev
POSTGRES_PORT=5442
DATABASE_PASSWORD=replace-with-a-random-local-secret
TZ=Asia/Hebron
DATABASE_URL=postgresql://labassist_owner:replace-with-a-random-local-secret@127.0.0.1:5442/labassist_auth_dev?schema=labassist_student
# Tests use a distinct database; it is never initialized by normal Compose startup.
TEST_DATABASE_URL=postgresql://labassist_owner:replace-with-a-random-local-secret@127.0.0.1:5442/labassist_auth_test?schema=labassist_student
# Optional private key for verifying the original Sprint 6 reviewer; obtain privately, never commit it.
SHARED_DATA_REVIEWER_KEY=
MAIL_ENCRYPTION_KEY=replace-with-64-hex-characters
SMTP_HOST=localhost
SMTP_PORT=1026
MAILPIT_HTTP_PORT=8026
SMTP_FROM=LabAssist <no-reply@labassist.local>
# Optional comma-separated recipient restriction for live SMTP trials; never redirects mail.
# SMTP_RECIPIENT_ALLOWLIST=your-test-address@stu.najah.edu
PUBLIC_APP_URL=http://localhost:8081/native
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8080,http://127.0.0.1:8080,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176
PORT=3100
ACTIVATION_HOURS=24
ACCESS_MINUTES=15
REFRESH_DAYS=14
# Browser-exposed variables must never contain secrets.

# Docker and backend configuration: copy to .env in the repository root.
# Do not change credentials/database name for an existing volume to "reset" it.
COMPOSE_PROJECT_NAME=labassist-auth-sprint1
POSTGRES_USER=labassist_owner
POSTGRES_DB=labassist_auth_dev
POSTGRES_PORT=5442
DATABASE_PASSWORD=replace-with-a-random-local-secret
TZ=Asia/Hebron
DATABASE_URL=postgresql://labassist_owner:replace-with-a-random-local-secret@localhost:5442/labassist_auth_dev?schema=labassist_student
# Tests use a distinct database; it is never initialized by normal Compose startup.
TEST_DATABASE_URL=postgresql://labassist_owner:replace-with-a-random-local-secret@localhost:5442/labassist_auth_test?schema=labassist_student
MAIL_ENCRYPTION_KEY=replace-with-64-hex-characters
SMTP_HOST=localhost
SMTP_PORT=1026
MAILPIT_HTTP_PORT=8026
SMTP_FROM=LabAssist <no-reply@labassist.local>
PUBLIC_APP_URL=http://localhost:8081/native
CORS_ORIGINS=http://localhost:8081,http://localhost:8080
PORT=3100
ACTIVATION_HOURS=24
ACCESS_MINUTES=15
REFRESH_DAYS=14
# Browser-exposed variables must never contain secrets.

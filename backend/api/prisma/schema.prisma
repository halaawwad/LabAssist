/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model academic_terms {
  id                        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seed_key                  String?                    @unique
  name                      String
  starts_on                 DateTime                   @db.Date
  ends_on                   DateTime?                  @db.Date
  is_demo                   Boolean                    @default(false)
  timezone                  String                     @default("Asia/Hebron")
  created_at                DateTime                   @default(now()) @db.Timestamptz(6)
  projects                  projects[]
  reporting_periods         reporting_periods[]
  student_enrollments       student_enrollments[]
  term_workshop_capacity    term_workshop_capacity?
  workshop_absence_policies workshop_absence_policies?
  workshop_days             workshop_days[]
  workshop_records          workshop_records[]
}

